MEDUSA_BACKEND_URL=http://localhost:9000
# Comma-separated exact origins for Medusa-managed product media stored outside the backend origin.
PRODUCT_MEDIA_ORIGINS=
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_with_storefront_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLED_MARKETS=zuribeans_ug,zuribeans_za
NEXT_PUBLIC_DEFAULT_MARKET=zuribeans_za
# Gate ZB-06 (ADR-0030): intersect catalogue with Trade market assortment.
# Trade #90 is merged — use strict in deployed estates once store assortment is deployed.
ZB06_ASSORTMENT_FILTER=strict
SUPPLIER_DB_URL=postgres://zuribeans:zuribeans_dev@localhost:5432/zuribeans_dev
# ADR 0015 / ZB-G03 step 2: confidential IAM BFF. Disabled unless both flags are "true".
# Needs an IAM-registered confidential client and a deployed Hydra login/consent provider.
ZURIBEANS_IAM_BFF_ENABLED=false
ZURIBEANS_IAM_ENVIRONMENT=development
ZURIBEANS_IAM_ORIGIN=https://zuribeans.example.test
BAOBAB_IAM_ISSUER=https://iam.example.test/
BAOBAB_IAM_INTROSPECTION_ENDPOINT=https://iam.example.test/oauth2/introspect
BAOBAB_IAM_AUDIENCE=baobab-trade
BAOBAB_IAM_CLIENT_ID=
ZURIBEANS_IAM_CLIENT_SECRET=
ZURIBEANS_IAM_ID_TOKEN_ALGORITHM=RS256
ZURIBEANS_IAM_TRUST_PROXY=false
ZURIBEANS_BFF_STORE_ENABLED=false
# JSON object of key id -> base64 32-byte AES-256-GCM key, e.g. {"k1":"<base64>"}
ZURIBEANS_BFF_STORE_KEYS_JSON=
ZURIBEANS_BFF_STORE_ACTIVE_KEY=
ZURIBEANS_BFF_STORE_EPOCH=
ZURIBEANS_BFF_REDIS_HOST=
ZURIBEANS_BFF_REDIS_PORT=6380
ZURIBEANS_BFF_REDIS_USERNAME=
ZURIBEANS_BFF_REDIS_PASSWORD=
ZURIBEANS_BFF_REDIS_CA_PEM=
