{
  "name": "ZuriBeans — Baobab private packages",
  "image": "ghcr.io/baobab-platform/baobab-dev:1.4.4-frontend@sha256:1b3165067912eacbca96b576efb67e0428850b1ff1a953aa9013127a01635371",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "TZ": "Africa/Johannesburg",
    "NEXT_TELEMETRY_DISABLED": "1",
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "forwardPorts": [
    3000,
    6006
  ],
  "portsAttributes": {
    "3000": {
      "label": "ZuriBeans Next.js",
      "onAutoForward": "openPreview",
      "visibility": "private"
    },
    "6006": {
      "label": "ZuriBeans Storybook",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "otherPortsAttributes": {
    "visibility": "private",
    "onAutoForward": "silent"
  },
  "updateContentCommand": "node --test scripts/codespaces/*.node.mjs",
  "postCreateCommand": "node scripts/codespaces/bootstrap.mjs && baobab-verify --contract",
  "postStartCommand": "node scripts/codespaces/private-npm.mjs",
  "waitFor": "updateContentCommand",
  "customizations": {
    "codespaces": {
      "repositories": {
        "baobab-platform/baobab-dev": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        },
        "baobab-platform/shared": {
          "permissions": {
            "contents": "read",
            "packages": "read"
          }
        }
      },
      "openFiles": [
        "README.md"
      ]
    },
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
