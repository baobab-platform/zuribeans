{
  "name": "Zuribeans",
  "image": "ghcr.io/nabhold/baobab-dev:1.4.0-frontend",
  "updateContentCommand": "corepack enable && pnpm install --frozen-lockfile",
  "postCreateCommand": "baobab-verify --contract && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
  "waitFor": "postCreateCommand",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Zuribeans", "onAutoForward": "openPreview" } },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "init": true,
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" },
  "containerEnv": { "TZ": "Africa/Johannesburg", "NEXT_TELEMETRY_DISABLED": "1" },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
